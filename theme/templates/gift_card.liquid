{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    <style>
      body{margin:0;min-height:100vh;display:grid;place-items:center;background:{{ settings.color_bg }};color:{{ settings.color_ink }};font-family:system-ui,sans-serif;text-align:center;padding:24px}
      .gc{max-width:440px;background:{{ settings.color_paper }};padding:48px 32px;border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.08)}
      .gc h1{font-family:Georgia,serif;font-weight:400;letter-spacing:.2em;font-size:22px}
      .gc .amt{font-size:44px;font-family:Georgia,serif;margin:16px 0}
      .gc code{display:block;font-size:20px;letter-spacing:.15em;padding:14px;border:1px dashed currentColor;border-radius:12px;margin:20px 0}
      .gc a{display:inline-block;margin-top:12px;padding:14px 28px;background:{{ settings.color_ink }};color:{{ settings.color_paper }};border-radius:999px;text-decoration:none}
    </style>
    {{ content_for_header }}
  </head>
  <body>
    <div class="gc">
      <h1>{{ settings.logo_text }}</h1>
      <p>{{ 'gift_card.title' | t }}</p>
      <p class="amt">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired or gift_card.enabled == false -%}<p>{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <code>{{ gift_card.code | format_code }}</code>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}">Apple Wallet</a></p>{%- endif -%}
      <a href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
    </div>
  </body>
</html>
