<section class="page section-top"><div class="container">
  <p class="eyebrow">마이페이지</p><h1 class="h1 page__title">{{ 'customer.hello' | t: name: customer.first_name }}</h1>
  <p><a href="{{ routes.account_logout_url }}" class="link-arrow">{{ 'customer.logout' | t }}</a> · <a href="{{ routes.account_addresses_url }}" class="link-arrow">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a></p>
  <h2 class="h3">{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="table"><thead><tr><th>#</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'cart.subtotal' | t }}</th></tr></thead><tbody>
        {%- for order in customer.orders -%}<tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: format: 'abbreviated_date' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money }}</td></tr>{%- endfor -%}
      </tbody></table>
    {%- else -%}<p class="muted">{{ 'customer.no_orders' | t }}</p>{%- endif -%}
  {%- endpaginate -%}
</div></section>
