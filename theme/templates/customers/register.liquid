<section class="page section-top"><div class="container container--narrow">
  <p class="eyebrow">회원가입</p><h1 class="h1 page__title">{{ 'customer.create' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row">
      <label><span>{{ 'customer.first_name' | t }}</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label><span>{{ 'customer.last_name' | t }}</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    </div>
    <label><span>{{ 'contact.email' | t }}</span><input type="email" name="customer[email]" autocomplete="email" required></label>
    <label><span>{{ 'general.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--dark">{{ 'customer.create' | t }}</button>
  {%- endform -%}
</div></section>
