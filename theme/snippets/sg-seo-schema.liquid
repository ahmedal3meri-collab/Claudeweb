{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  {%- if settings.logo != blank -%}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{%- endif -%}
  "description": "Authentic Korean skincare and KAVO Korean fashion, held in the UAE and delivered in 1–3 days.",
  "areaServed": "AE",
  "currenciesAccepted": {{ cart.currency.iso_code | json }},
  "sameAs": [{%- assign socials = '' -%}{%- if settings.social_instagram != blank -%}{%- assign socials = socials | append: settings.social_instagram | append: '|' -%}{%- endif -%}{%- if settings.social_tiktok != blank -%}{%- assign socials = socials | append: settings.social_tiktok | append: '|' -%}{%- endif -%}{%- if settings.social_snapchat != blank -%}{%- assign socials = socials | append: settings.social_snapchat | append: '|' -%}{%- endif -%}{%- assign sl = socials | split: '|' -%}{%- for u in sl -%}{{ u | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
  "potentialAction": { "@type": "SearchAction", "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }}, "query-input": "required name=search_term_string" }
}
</script>
{%- endif -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | json }} }
    {%- if collection -%},{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }{%- endif -%}
    {%- if product -%},{ "@type": "ListItem", "position": {% if collection %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }{%- endif -%}
  ]
}
</script>
{%- endif -%}
