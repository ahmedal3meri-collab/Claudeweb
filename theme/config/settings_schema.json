[
  {
    "name": "theme_info",
    "theme_name": "Seoul Glow Maison",
    "theme_version": "1.0.0",
    "theme_author": "Seoul Glow",
    "theme_documentation_url": "https://seoulglowuae.com",
    "theme_support_url": "https://seoulglowuae.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo (optional — text logo used if empty)" },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140 },
      { "type": "text", "id": "logo_text", "label": "Text logo", "default": "SEOUL GLOW" },
      { "type": "text", "id": "logo_korean", "label": "Korean accent under logo", "default": "서울 글로우" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "checkbox", "id": "show_preloader", "label": "Show cinematic intro (once per visit)", "default": true }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#F7F2EC" },
      { "type": "color", "id": "color_paper", "label": "Surface", "default": "#FFFDFA" },
      { "type": "color", "id": "color_ink", "label": "Text", "default": "#161313" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#7C746C" },
      { "type": "color", "id": "color_accent", "label": "Accent (rose)", "default": "#B9776C" },
      { "type": "color", "id": "color_blush", "label": "Blush", "default": "#EBD3CA" },
      { "type": "color", "id": "color_celadon", "label": "Celadon", "default": "#AFC2B0" },
      { "type": "color", "id": "color_gold", "label": "Champagne", "default": "#B89A6A" },
      { "type": "color", "id": "color_dark", "label": "KAVO dark", "default": "#0F0E0D" }
    ]
  },
  {
    "name": "Commerce",
    "settings": [
      { "type": "range", "id": "free_shipping_threshold", "label": "Free delivery threshold", "min": 0, "max": 1000, "step": 10, "unit": "AED", "default": 200 },
      { "type": "range", "id": "low_stock_threshold", "label": "Show “only X left” at or below", "min": 0, "max": 20, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "show_vendor", "label": "Show brand on product cards", "default": true },
      { "type": "checkbox", "id": "show_second_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add", "default": true },
      { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (international, digits only, e.g. 9715XXXXXXXX)", "info": "Leave empty to hide the floating WhatsApp button." },
      { "type": "text", "id": "whatsapp_message", "label": "WhatsApp default message", "default": "Hi Seoul Glow! I need help choosing my routine ✨" }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_snapchat", "label": "Snapchat URL" }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      { "type": "checkbox", "id": "enable_reveal", "label": "Reveal sections on scroll", "default": true },
      { "type": "checkbox", "id": "enable_grain", "label": "Subtle film grain on hero imagery", "default": true }
    ]
  }
]
