[
  {
    "name": "theme_info",
    "theme_name": "Seoul Glow Maison",
    "theme_version": "1.0.0",
    "theme_author": "Seoul Glow",
    "theme_documentation_url": "https://seoulglowuae.com",
    "theme_support_url": "https://seoulglowuae.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optional — text logo used if empty)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Text logo",
        "default": "SEOUL GLOW"
      },
      {
        "type": "text",
        "id": "logo_korean",
        "label": "Korean accent under logo",
        "default": "서울 글로우"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "checkbox",
        "id": "show_preloader",
        "label": "Show cinematic intro (once per visit)",
        "default": true
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#ECE5D9"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Surface",
        "default": "#F6F1E8"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text",
        "default": "#141110"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#776C61"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (rose)",
        "default": "#BF2A1F"
      },
      {
        "type": "color",
        "id": "color_blush",
        "label": "Blush",
        "default": "#E2CCB4"
      },
      {
        "type": "color",
        "id": "color_celadon",
        "label": "Celadon",
        "default": "#A8B09E"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Champagne",
        "default": "#B26A2C"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "KAVO dark",
        "default": "#0B0A09"
      }
    ]
  },
  {
    "name": "Commerce",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free delivery threshold",
        "min": 0,
        "max": 1000,
        "step": 10,
        "unit": "AED",
        "default": 500
      },
      {
        "type": "range",
        "id": "reduced_shipping_threshold",
        "label": "Reduced delivery threshold",
        "info": "Orders above this pay the reduced delivery fee. Set 0 to hide this tier.",
        "min": 0,
        "max": 1000,
        "step": 10,
        "unit": "AED",
        "default": 200
      },
      {
        "type": "range",
        "id": "reduced_shipping_fee",
        "label": "Reduced delivery fee",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "AED",
        "default": 10
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Show “only X left” at or below",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show brand on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "Enable quick add",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (international, digits only, e.g. 9715XXXXXXXX)",
        "info": "Leave empty to hide the floating WhatsApp button."
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp default message",
        "default": "Hi Seoul Glow! I need help choosing my routine ✨"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_snapchat",
        "label": "Snapchat URL"
      }
    ]
  },
  {
    "name": "KAVO Night Drop",
    "settings": [
      { "type": "paragraph", "content": "Weekly drop countdown (UAE time). Products tagged next-drop are locked until the drop goes live." },
      { "type": "select", "id": "drop_weekday", "label": "Drop day", "default": "4", "options": [
        { "value": "0", "label": "Sunday" }, { "value": "1", "label": "Monday" }, { "value": "2", "label": "Tuesday" }, { "value": "3", "label": "Wednesday" },
        { "value": "4", "label": "Thursday" }, { "value": "5", "label": "Friday" }, { "value": "6", "label": "Saturday" } ] },
      { "type": "range", "id": "drop_hour", "label": "Drop hour (24h, UAE)", "min": 0, "max": 23, "step": 1, "default": 21 },
      { "type": "text", "id": "drop_datetime", "label": "One-off drop date (optional)", "info": "Overrides the weekly schedule while in the future. Format: 2026-11-20T21:00" },
      { "type": "range", "id": "drop_live_hours", "label": "Show 'Live now' for", "min": 1, "max": 72, "step": 1, "unit": "h", "default": 24 },
      { "type": "text", "id": "drop_name", "label": "Drop name", "default": "Drop 002" }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_reveal",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_grain",
        "label": "Subtle film grain on hero imagery",
        "default": true
      }
    ]
  }
]