<section class="concerns section">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
        <h2 class="h1">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
      </div>
      <p class="section-head__aside muted">{% render 'tx', en: section.settings.text, ar: section.settings.text_ar %}</p>
    </div>
  </div>
  <div class="concerns__track container-bleed" data-rail>
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign img = block.settings.image
        if img == blank and col != blank
          if col.featured_image
            assign img = col.featured_image
          else
            for p in col.products
              if p.featured_media
                assign img = p.featured_media
                break
              endif
            endfor
          endif
        endif
      -%}
      <a href="{% if col != blank %}{{ col.url }}{% else %}#{% endif %}" class="concern" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 70 }}ms">
        <div class="concern__arch{% if img != blank %} is-fit{% endif %}"{% if img != blank %} style="--fit-bg: url('{{ img | image_url: width: 80 }}')"{% endif %}>
          {%- if img != blank -%}{{ img | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '240px', widths: '300,450,600', alt: '' }}{%- endif -%}
          <span class="concern__kr">{{ block.settings.korean }}</span>
        </div>
        <p class="concern__title">{% render 'tx', en: block.settings.title, ar: block.settings.title_ar %}</p>
        {%- if col != blank -%}<p class="concern__count">{{ 'collections.products_count' | t: count: col.products_count }}</p>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by concern",
  "class": "section-concerns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by concern" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "تسوقي حسب احتياج بشرتك" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What does your skin ask for?" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "ماذا تحتاج بشرتك؟" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Edited for Gulf skin: heat, humidity and all-day air conditioning." },
    { "type": "textarea", "id": "text_ar", "label": "Text (Arabic)", "default": "مختارة لبشرة الخليج: الحرارة والرطوبة والمكيّف طوال اليوم." }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional — uses first product)" },
        { "type": "text", "id": "korean", "label": "Korean word", "default": "광채" },
        { "type": "text", "id": "title", "label": "Title", "default": "Glow" },
        { "type": "text", "id": "title_ar", "label": "Title (Arabic)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Shop by concern", "blocks": [{ "type": "concern" }, { "type": "concern" }, { "type": "concern" }] }]
}
{% endschema %}
