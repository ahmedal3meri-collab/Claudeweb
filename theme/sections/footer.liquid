<footer class="footer">
  <div class="footer__big container" data-reveal>
    <p class="footer__kr">{{ settings.logo_korean }}</p>
    <p class="footer__word">{{ settings.logo_text }}</p>
  </div>
  <div class="footer__grid container">
    <div class="footer__col footer__col--news">
      <h3 class="footer__h">{% render 'tx', en: section.settings.news_heading, ar: section.settings.news_heading_ar %}</h3>
      <p class="muted">{% render 'tx', en: section.settings.news_text, ar: section.settings.news_text_ar %}</p>
      {%- form 'customer', class: 'news-form', id: 'FooterNews' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="news-form__ok">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="news-form__row">
            <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}" autocomplete="email">
            <button type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', name: 'arrow' %}</button>
          </div>
          {%- if form.errors -%}<p class="news-form__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <div class="socials">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        {%- if settings.social_snapchat != blank -%}<a href="{{ settings.social_snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat">{% render 'icon', name: 'snapchat' %}</a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        <h3 class="footer__h">{% render 'tx', en: block.settings.heading, ar: block.settings.heading_ar %}</h3>
        {%- if block.type == 'menu' -%}
          {%- assign m = block.settings.menu -%}
          {%- if request.locale.iso_code == 'ar' and block.settings.menu_ar != blank -%}{%- assign m = block.settings.menu_ar -%}{%- endif -%}
          <ul class="footer__links">
            {%- for link in m.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        {%- else -%}
          <div class="rte muted">{% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__bottom container">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.made_in' | t }}</p>
    {%- if section.settings.show_payment -%}
      <ul class="payments">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Join the Glow List" },
    { "type": "text", "id": "news_heading_ar", "label": "Newsletter heading (Arabic)", "default": "انضمي لقائمة التوهّج" },
    { "type": "textarea", "id": "news_text", "label": "Newsletter text", "default": "First access to new K-beauty arrivals, KAVO drops and members-only offers." },
    { "type": "textarea", "id": "news_text_ar", "label": "Newsletter text (Arabic)", "default": "كوني أول من يعرف عن وصول منتجات الجمال الكورية الجديدة وإصدارات KAVO والعروض الحصرية." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "link_list", "id": "menu_ar", "label": "Menu for Arabic storefront" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Seoul Glow" },
        { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Authentic Korean beauty and KAVO fashion, held in the UAE and delivered in 1–3 days.</p>" },
        { "type": "richtext", "id": "text_ar", "label": "Text (Arabic)" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
