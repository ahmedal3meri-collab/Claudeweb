<section class="trust{% if section.settings.tone == 'dark' %} tone-dark{% endif %}">
  <div class="container trust__grid">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 90 }}ms">
        <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div>
          <p class="trust__title">{% render 'tx', en: block.settings.title, ar: block.settings.title_ar %}</p>
          <p class="trust__text">{% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "class": "section-trust",
  "settings": [
    { "type": "select", "id": "tone", "label": "Background", "default": "none", "options": [{ "value": "none", "label": "Default" }, { "value": "dark", "label": "Dark" }] }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [{ "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Truck" }, { "value": "cash", "label": "Cash" }, { "value": "return", "label": "Return" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "1–3 day UAE delivery" },
        { "type": "text", "id": "title_ar", "label": "Title (Arabic)" },
        { "type": "text", "id": "text", "label": "Text", "default": "Shipped from inside the UAE." },
        { "type": "text", "id": "text_ar", "label": "Text (Arabic)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
