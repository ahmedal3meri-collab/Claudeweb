<section class="marquee{% if section.settings.tone == 'dark' %} tone-dark{% endif %} marquee--{{ section.settings.style }}" style="--speed: {{ section.settings.speed }}s">
  <div class="marquee__track{% if section.settings.reverse %} is-reverse{% endif %}">
    {%- for i in (1..2) -%}
      <div class="marquee__group" {% if forloop.last %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="marquee__item" {{ block.shopify_attributes }}>{%- else -%}<span class="marquee__item" {{ block.shopify_attributes }}>{%- endif -%}
            {% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          <span class="marquee__sep" aria-hidden="true">{{ section.settings.separator }}</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "class": "section-marquee",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "serif", "options": [{ "value": "serif", "label": "Large serif" }, { "value": "caps", "label": "Small caps" }] },
    { "type": "select", "id": "tone", "label": "Background", "default": "none", "options": [{ "value": "none", "label": "Default" }, { "value": "dark", "label": "Dark" }] },
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 35 },
    { "type": "checkbox", "id": "reverse", "label": "Reverse direction", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Medicube" },
        { "type": "text", "id": "text_ar", "label": "Text (Arabic)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Marquee", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
