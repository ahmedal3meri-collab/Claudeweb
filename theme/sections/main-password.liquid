<section class="pw">
  <div class="pw__inner">
    <p class="logo__kr">{{ settings.logo_korean }}</p>
    <h1 class="pw__word">{{ settings.logo_text }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="news-form__ok">{{ 'newsletter.success' | t }}</p>{%- else -%}
        <div class="news-form__row"><input type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}"><button type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">→</button></div>
      {%- endif -%}
    {%- endform -%}
    <details class="pw__login">
      <summary>{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="news-form__row"><input type="password" name="password" placeholder="{{ 'general.password' | t }}" aria-label="{{ 'general.password' | t }}"><button type="submit">→</button></div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
