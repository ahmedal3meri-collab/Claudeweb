<section class="section-top">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">저널 · Journal</p><h1 class="h1">{{ blog.title }}</h1></div></div>
    {%- paginate blog.articles by 9 -%}
      <div class="journal">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="jcard" data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 90 }}ms">
            <div class="jcard__img">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '450,700,900', alt: article.title }}{%- endif -%}</div>
            <p class="eyebrow">{{ article.published_at | date: format: 'abbreviated_date' }}</p>
            <h2 class="h3">{{ article.title }}</h2>
            <p class="muted" dir="auto">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
