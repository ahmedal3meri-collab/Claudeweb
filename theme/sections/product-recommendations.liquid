<section class="rail section" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
          <h2 class="h2">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
        </div>
      </div>
    </div>
    <div class="rail__panel is-active">
      <div class="rail__track container-bleed" data-rail>
        {%- for product in recommendations.products -%}
          <div class="rail__item">{% render 'product-card', product: product, index: forloop.index0 %}</div>
        {%- endfor -%}
      </div>
      <div class="container rail__foot">
        <div class="rail__progress"><span data-rail-progress></span></div>
        <div class="rail__nav">
          <button type="button" class="round-btn" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
          <button type="button" class="round-btn" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Complete the ritual",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pairs beautifully with" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "يتناغم بشكل جميل مع" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the ritual" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "أكملي الروتين" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 10, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Complete the ritual" }]
}
{% endschema %}
