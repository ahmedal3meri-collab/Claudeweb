{%- comment -%} Brand story — statement, image and three principles. {%- endcomment -%}
<section class="ed-story ed-sec{% if section.settings.tone == 'ivory' %} ed-tone-ivory{% endif %}">
  <div class="ed-wrap">
    <div class="ed-story__top">
      <p class="ed-kicker" data-reveal>{% render 'tx', en: section.settings.kicker, ar: section.settings.kicker_ar %}</p>
      <h2 class="ed-story__statement" data-reveal style="--d: 80ms">{% render 'ed-em', en: section.settings.statement, ar: section.settings.statement_ar %}</h2>
    </div>
    <div class="ed-story__grid">
      {%- if section.settings.image != blank -%}
        <figure class="ed-story__img" data-reveal>
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600,1000,1400', alt: section.settings.image.alt | default: '' }}
        </figure>
      {%- endif -%}
      <ol class="ed-story__list">
        {%- for block in section.blocks -%}
          <li class="ed-story__item" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 100 }}ms">
            <span class="ed-num">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="ed-h3">{% render 'tx', en: block.settings.title, ar: block.settings.title_ar %}</h3>
            <p class="ed-body">{% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}</p>
          </li>
        {%- endfor -%}
        {%- if section.settings.link != blank -%}
          <li class="ed-story__more"><a class="ed-link" href="{{ section.settings.link }}">{% render 'tx', en: section.settings.button, ar: section.settings.button_ar %}</a></li>
        {%- endif -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial — brand story",
  "class": "section-ed-story",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "tone", "label": "Background", "default": "ivory", "options": [{ "value": "none", "label": "Off-white" }, { "value": "ivory", "label": "Ivory" }] },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "About Seoul Glow" },
    { "type": "text", "id": "kicker_ar", "label": "Kicker (Arabic)", "default": "عن سيول جلو" },
    { "type": "textarea", "id": "statement", "label": "Statement" },
    { "type": "textarea", "id": "statement_ar", "label": "Statement (Arabic)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button", "label": "Link label", "default": "Our story" },
    { "type": "text", "id": "button_ar", "label": "Link label (Arabic)", "default": "قصتنا" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "point", "name": "Principle", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Curated, not crowded" },
      { "type": "text", "id": "title_ar", "label": "Title (Arabic)" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "textarea", "id": "text_ar", "label": "Text (Arabic)" }
    ] }
  ],
  "presets": [{ "name": "Editorial — brand story", "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }] }]
}
{% endschema %}
