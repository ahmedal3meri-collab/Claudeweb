<section class="booth" data-booth
  data-code="{{ section.settings.code | escape }}"
  data-brand="{{ settings.logo_text | default: shop.name | escape }}"
  data-brand-kr="{{ settings.logo_korean | escape }}"
  data-site="{{ shop.domain | escape }}"
  data-reward="{% render 'tx', en: section.settings.reward, ar: section.settings.reward_ar %}"
  data-shot="{{ 'booth.shot' | t | escape }}"
  data-copied="{{ 'booth.copied' | t | escape }}"
  data-denied="{{ 'booth.denied' | t | escape }}">
  <div class="container booth__grid">
    <div class="booth__copy">
      <p class="eyebrow booth__eyebrow">인생네컷 · Photo booth</p>
      <h1 class="booth__title">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h1>
      <p class="booth__text">{% render 'tx', en: section.settings.text, ar: section.settings.text_ar %}</p>
      <ol class="booth__steps">
        <li><b>01</b> {% render 'tx', en: section.settings.step1, ar: section.settings.step1_ar %}</li>
        <li><b>02</b> {% render 'tx', en: section.settings.step2, ar: section.settings.step2_ar %}</li>
        <li><b>03</b> {% render 'tx', en: section.settings.step3, ar: section.settings.step3_ar %}</li>
      </ol>
      <p class="booth__privacy">{% render 'icon', name: 'shield' %} {{ 'booth.privacy' | t }}</p>
    </div>

    <div class="booth__machine">
      <div class="booth__screen" data-booth-screen>
        <video class="booth__video" data-booth-video playsinline muted autoplay hidden></video>
        <div class="booth__idle" data-booth-idle>
          <span class="booth__idle-kr">찰칵</span>
          <span class="booth__idle-en">4 shots · direct flash</span>
        </div>
        <div class="booth__count" data-booth-count aria-live="assertive"></div>
        <div class="booth__flash" data-booth-flash aria-hidden="true"></div>
        <div class="booth__dots" data-booth-dots aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <img class="booth__result" data-booth-result alt="" width="1080" height="1920" hidden>
      </div>

      <div class="booth__filters" role="radiogroup" aria-label="{{ 'booth.filter' | t }}" data-booth-filters>
        <button type="button" role="radio" aria-checked="true" data-filter="film" class="is-on">Film</button>
        <button type="button" role="radio" aria-checked="false" data-filter="flash">Flash B&amp;W</button>
        <button type="button" role="radio" aria-checked="false" data-filter="night">Seoul Night</button>
      </div>

      <div class="booth__controls">
        <button type="button" class="btn btn--dark booth__start" data-booth-start>{{ 'booth.start' | t }} {% render 'icon', name: 'sparkle' %}</button>
        <label class="booth__upload">
          <input type="file" accept="image/*" multiple data-booth-upload>
          <span>{{ 'booth.upload' | t }}</span>
        </label>
      </div>

      <div class="booth__done" data-booth-done hidden>
        <div class="booth__done-row">
          <button type="button" class="btn btn--dark" data-booth-share>{{ 'booth.share' | t }} {% render 'icon', name: 'arrow' %}</button>
          <a class="btn btn--ghost-dark" data-booth-download download="seoul-glow-booth.jpg" href="#">{{ 'booth.download' | t }}</a>
          <button type="button" class="booth__retake" data-booth-retake>{{ 'booth.retake' | t }}</button>
        </div>
        {%- if section.settings.code != blank -%}
          <div class="booth__reward">
            <p class="booth__reward-t">{{ 'booth.code_title' | t }}</p>
            <p class="booth__reward-d">{% render 'tx', en: section.settings.reward, ar: section.settings.reward_ar %}</p>
            <button type="button" class="booth__code" data-booth-copy dir="ltr">{{ section.settings.code }} <span>{{ 'booth.copy' | t }}</span></button>
          </div>
        {%- endif -%}
      </div>
      <p class="booth__error" data-booth-error hidden></p>
    </div>
  </div>
</section>
<script src="{{ 'photo-booth.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Seoul photo booth",
  "class": "section-photo-booth",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four frames. One flash. Pure Seoul." },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "أربع لقطات. فلاش واحد. سيول كاملة." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Step into our Seoul photo booth — four shots, film filter, a Seoul Glow frame ready for your story." },
    { "type": "textarea", "id": "text_ar", "label": "Text (Arabic)", "default": "ادخلي كشك صور سيول — أربع لقطات، فلتر فيلم، وإطار Seoul Glow جاهز للستوري." },
    { "type": "text", "id": "step1", "label": "Step 1", "default": "Pick a film and press start" },
    { "type": "text", "id": "step1_ar", "label": "Step 1 (Arabic)", "default": "اختاري الفلتر واضغطي ابدئي" },
    { "type": "text", "id": "step2", "label": "Step 2", "default": "Pose — 4 shots, 3 seconds each" },
    { "type": "text", "id": "step2_ar", "label": "Step 2 (Arabic)", "default": "وقفي — ٤ لقطات، كل وحدة ٣ ثواني" },
    { "type": "text", "id": "step3", "label": "Step 3", "default": "Share to your story, tag us, unlock your reward" },
    { "type": "text", "id": "step3_ar", "label": "Step 3 (Arabic)", "default": "شاركيها في الستوري، اعملي لنا تاق، واكسبي هديتك" },
    { "type": "header", "content": "Reward" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "SEOULSNAP" },
    { "type": "text", "id": "reward", "label": "Reward text", "default": "10% off your next order" },
    { "type": "text", "id": "reward_ar", "label": "Reward text (Arabic)", "default": "خصم ١٠٪ على طلبك الجاي" }
  ],
  "presets": [{ "name": "Seoul photo booth" }]
}
{% endschema %}
