<section class="rail section recent" data-recently-viewed data-limit="{{ section.settings.limit }}" hidden>
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
        <h2 class="h2">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
      </div>
    </div>
  </div>
  <div class="rail__panel is-active">
    <div class="rail__track container-bleed" data-rail></div>
    <div class="container rail__foot">
      <div class="rail__progress"><span data-rail-progress></span></div>
      <div class="rail__nav">
        <button type="button" class="round-btn" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
        <button type="button" class="round-btn" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Still thinking?" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "لسه تفكرين؟" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "شاهدتِها مؤخراً" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
