{%- liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign heading = section.settings.heading
  if is_ar and section.settings.heading_ar != blank
    assign heading = section.settings.heading_ar
  endif
  assign lines = heading | split: '|'
-%}
<section class="hero hero--{{ section.settings.align }}{% if section.settings.theme == 'dark' %} hero--dark{% endif %}" data-hero style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}">
  <div class="hero__media" data-parallax="0.18">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'hero__video', image_size: '1600x' }}
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w">
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1100,1500,1900,2400', class: 'hero__img' }}
      </picture>
    {%- else -%}
      <div class="hero__fallback"></div>
    {%- endif -%}
    <div class="hero__shade"></div>
    <div class="grain"></div>
  </div>
  {%- if section.settings.stamp != blank -%}<span class="film-stamp hero__stamp" aria-hidden="true">{{ section.settings.stamp }}</span>{%- endif -%}

  {%- if section.settings.vertical_kr != blank -%}
    <p class="hero__vertical" aria-hidden="true">{{ section.settings.vertical_kr }}</p>
  {%- endif -%}

  <div class="hero__content container">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow hero__eyebrow" data-hero-in style="--d: 200ms">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
      {%- endif -%}
      <h1 class="hero__title">
        {%- for line in lines -%}
          <span class="line"><span class="line__in" style="--d: {{ forloop.index0 | times: 140 | plus: 350 }}ms">{{ line | strip | replace: '*', '<em>' | replace: '~', '</em>' }}</span></span>
        {%- endfor -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="hero__text" data-hero-in style="--d: 900ms">{% render 'tx', en: section.settings.text, ar: section.settings.text_ar %}</p>
      {%- endif -%}
      <div class="hero__ctas" data-hero-in style="--d: 1050ms">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link }}" class="btn btn--light btn--shine" data-magnetic>{% render 'tx', en: section.settings.btn1_label, ar: section.settings.btn1_label_ar %} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link }}" class="btn btn--ghost" data-magnetic>{% render 'tx', en: section.settings.btn2_label, ar: section.settings.btn2_label_ar %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="hero__foot container" data-hero-in style="--d: 1300ms">
    <div class="hero__stats">
      {%- for block in section.blocks -%}
        <div class="hero__stat" {{ block.shopify_attributes }}>
          <strong dir="ltr">{{ block.settings.value }}</strong>
          <span>{% render 'tx', en: block.settings.label, ar: block.settings.label_ar %}</span>
        </div>
      {%- endfor -%}
    </div>
    <a href="#hero-next-{{ section.id }}" class="hero__scroll" aria-label="{{ 'general.scroll' | t }}"><span></span></a>
  </div>
</section>
<span id="hero-next-{{ section.id }}"></span>

{% schema %}
{
  "name": "Cinematic hero",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile, portrait)" },
    { "type": "video", "id": "video", "label": "Background video (optional, overrides image)" },
    { "type": "range", "id": "overlay", "label": "Shade strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "select", "id": "align", "label": "Text position", "default": "start", "options": [{ "value": "start", "label": "Start" }, { "value": "center", "label": "Center" }] },
    { "type": "select", "id": "theme", "label": "Text color", "default": "dark", "options": [{ "value": "dark", "label": "Light text on image" }, { "value": "light", "label": "Dark text on image" }] },
    { "type": "text", "id": "vertical_kr", "label": "Vertical Korean text", "default": "빛나는 피부의 비밀" },
    { "type": "text", "id": "stamp", "label": "Film date stamp (e.g. '26 11 02)", "default": "'26 11 02" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Seoul → Dubai · Authentic K-Beauty" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "من سيول إلى الإمارات · جمال كوري أصلي" },
    { "type": "text", "id": "heading", "label": "Heading (use | for new lines, *word~ for italic)", "default": "The *quiet~ glow|of Seoul." },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "توهّج سيول|*الهادئ~" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Curated Korean skincare and KAVO fashion — authentic, held in the UAE, at your door in 1–3 days." },
    { "type": "textarea", "id": "text_ar", "label": "Text (Arabic)", "default": "عناية كورية مختارة وأزياء KAVO — أصلية ١٠٠٪، من مخازننا في الإمارات إلى باب بيتك خلال ١–٣ أيام." },
    { "type": "text", "id": "btn1_label", "label": "Button 1", "default": "Shop Beauty" },
    { "type": "text", "id": "btn1_label_ar", "label": "Button 1 (Arabic)", "default": "تسوقي الجمال" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link", "default": "/collections/all" },
    { "type": "text", "id": "btn2_label", "label": "Button 2", "default": "Discover KAVO" },
    { "type": "text", "id": "btn2_label_ar", "label": "Button 2 (Arabic)", "default": "اكتشفي KAVO" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Authentic" },
        { "type": "text", "id": "label_ar", "label": "Label (Arabic)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Cinematic hero" }]
}
{% endschema %}
