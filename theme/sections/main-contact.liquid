<section class="page section-top">
  <div class="container container--narrow">
    <p class="eyebrow">연락처</p>
    <h1 class="h1 page__title">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte page__body" dir="auto">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__ok">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<div class="form__err">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form__row">
        <label><span>{{ 'contact.name' | t }}</span><input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
        <label><span>{{ 'contact.email' | t }}</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
      </div>
      <label><span>{{ 'contact.phone' | t }}</span><input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
      <label><span>{{ 'contact.message' | t }}</span><textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea></label>
      <button type="submit" class="btn btn--dark">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Contact form", "settings": [] }
{% endschema %}
