{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  assign tier = settings.reduced_shipping_threshold | times: 100
  assign tier_remaining = tier | minus: cart.total_price
  assign tier_remaining_money = tier_remaining | money
  assign pct = 100
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<section class="cart-page section-top{% if section.settings.receipt %} is-receipt{% endif %}">
  <div class="container">
    <div class="section-head"><div><p class="eyebrow">장바구니</p><h1 class="h1">{{ 'cart.title' | t }}</h1></div></div>
    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p class="empty-state__kr">비어 있음</p>
        <p class="h2">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid">
        <div>
          {%- if section.settings.receipt -%}{% render 'receipt', part: 'head' %}{%- endif -%}
          <ul class="cart-lines cart-lines--page">
            {%- for item in cart.items -%}
              <li class="cart-line">
                <a href="{{ item.url }}" class="cart-line__img">{%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}</a>
                <div class="cart-line__info">
                  <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="cart-line__variant">{{ item.variant.title }}</p>{%- endunless -%}
                  <div class="cart-line__row">
                    <div class="qty qty--sm"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.quantity' | t }}"></div>
                    <span class="cart-line__price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart-line__remove">{{ 'cart.remove' | t }}</a>
                </div>
              </li>
            {%- endfor -%}
          </ul>
          <button type="submit" name="update" class="btn btn--ghost-dark">{{ 'cart.update' | t }}</button>
        </div>
        <aside class="cart-summary">
          {%- if threshold > 0 -%}
            <div class="ship-bar">
              <p>{%- if tier > 0 and tier_remaining > 0 and tier < threshold -%}{{ 'cart.reduced_shipping_remaining_html' | t: amount: tier_remaining_money, fee: settings.reduced_shipping_fee }}{%- elsif remaining > 0 -%}{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}{%- else -%}{{ 'cart.free_shipping_unlocked' | t }}{%- endif -%}</p>
              <div class="ship-bar__track"><span style="--p: {{ pct }}%"></span></div>
            </div>
          {%- endif -%}
          <label class="cart-note"><span>{{ 'cart.note' | t }}</span><textarea name="note" rows="3">{{ cart.note }}</textarea></label>
          <p class="cart-foot__row cart-foot__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
          <p class="small muted">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="btn btn--dark btn--full btn--shine">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button>
          {%- if additional_checkout_buttons -%}<div class="cart-summary__dyn">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          {%- if section.settings.receipt -%}{% render 'receipt', part: 'foot' %}{%- endif -%}
          <ul class="pdp__perks">
            <li>{% render 'icon', name: 'cash' %} {{ 'trust.cod' | t }}</li>
            <li>{% render 'icon', name: 'shield' %} {{ 'trust.authentic' | t }}</li>
            <li>{% render 'icon', name: 'return' %} {{ 'trust.returns' | t }}</li>
          </ul>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart", "settings": [{ "type": "checkbox", "id": "receipt", "label": "Korean receipt style", "default": true }] }
{% endschema %}
