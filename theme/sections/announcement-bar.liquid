{%- liquid
  assign ctx = 'beauty'
  if template.name == 'product' and product.tags contains 'kavo'
    assign ctx = 'fashion'
  elsif template.name == 'collection' and collection.handle contains 'kavo'
    assign ctx = 'fashion'
  elsif template.name == 'page' and template.suffix == 'kavo'
    assign ctx = 'fashion'
  endif
  assign shown = 0
-%}
{%- if section.settings.style == 'static' -%}
  <div class="announce announce--static">
    {%- for block in section.blocks -%}
      {%- assign bctx = block.settings.context | default: 'all' -%}
      {%- if shown == 0 and bctx == 'all' or shown == 0 and bctx == ctx -%}
        {%- assign shown = 1 -%}
        <p class="announce__static" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
          {% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </p>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- else -%}
<div class="announce" style="--speed: {{ section.settings.speed }}s">
  <div class="announce__track" aria-label="{{ 'general.announcements' | t }}">
    {%- for i in (1..2) -%}
      <div class="announce__group" {% if forloop.last %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- assign bctx = block.settings.context | default: 'all' -%}
          {%- unless bctx == 'all' or bctx == ctx -%}{%- continue -%}{%- endunless -%}
          <span class="announce__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </span>
          <span class="announce__dot" aria-hidden="true">✦</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement marquee",
  "class": "section-announce",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "marquee", "label": "Scrolling marquee" }, { "value": "static", "label": "Single static message" } ], "default": "marquee", "info": "Static shows the first message that matches the page (Fashion or Beauty)." },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text (English)", "default": "Free UAE delivery over 500 AED" },
        { "type": "text", "id": "text_ar", "label": "Text (Arabic)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "context", "label": "Show on", "options": [ { "value": "all", "label": "All pages" }, { "value": "beauty", "label": "Beauty pages" }, { "value": "fashion", "label": "Fashion (KAVO) pages" } ], "default": "all", "info": "Only truthful, currently valid messages." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Announcement marquee", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
