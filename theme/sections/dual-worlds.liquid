<section class="worlds section" id="worlds-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
      <h2 class="h1">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
    </div>
  </div>
  <div class="worlds__row">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link }}" class="world world--{{ block.settings.tone }}" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 120 }}ms">
        <div class="world__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600,900,1200,1600', class: 'world__img' }}
          {%- else -%}
            <div class="world__ph"></div>
          {%- endif -%}
        </div>
        <div class="world__content">
          <span class="world__num">0{{ forloop.index }}</span>
          <p class="world__kr">{{ block.settings.korean }}</p>
          <h3 class="world__title">{% render 'tx', en: block.settings.title, ar: block.settings.title_ar %}</h3>
          <p class="world__text">{% render 'tx', en: block.settings.text, ar: block.settings.text_ar %}</p>
          <span class="world__cta">{% render 'tx', en: block.settings.cta, ar: block.settings.cta_ar %} {% render 'icon', name: 'arrow' %}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Two worlds split",
  "class": "section-worlds",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two houses · One standard" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "عالمان · معيار واحد" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skin first. Then the wardrobe." },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "البشرة أولاً، ثم الإطلالة." }
  ],
  "blocks": [
    {
      "type": "world",
      "name": "World",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "tone", "label": "Tone", "default": "light", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
        { "type": "text", "id": "korean", "label": "Korean word", "default": "뷰티" },
        { "type": "text", "id": "title", "label": "Title", "default": "Seoul Glow Beauty" },
        { "type": "text", "id": "title_ar", "label": "Title (Arabic)" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Medicube, numbuzin, SKIN1004, Anua, Beauty of Joseon — chosen for skin living in the Gulf." },
        { "type": "textarea", "id": "text_ar", "label": "Text (Arabic)" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Enter beauty" },
        { "type": "text", "id": "cta_ar", "label": "Link label (Arabic)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Two worlds split", "blocks": [{ "type": "world" }, { "type": "world" }] }]
}
{% endschema %}
