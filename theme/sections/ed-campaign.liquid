{%- comment -%} Asymmetric editorial campaign: hero image, detail image, copy, shop-the-look. {%- endcomment -%}
<section class="ed-camp ed-sec ed-camp--{{ section.settings.layout }}{% if section.settings.tone == 'ivory' %} ed-tone-ivory{% elsif section.settings.tone == 'dark' %} ed-tone-dark{% endif %}">
  <div class="ed-wrap ed-camp__grid">
    <figure class="ed-camp__a" data-reveal>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 58vw, 100vw', widths: '700,1000,1300,1600', alt: section.settings.image.alt | default: section.settings.heading }}
      {%- endif -%}
    </figure>
    <div class="ed-camp__side">
      <div class="ed-camp__copy" data-reveal style="--d: 120ms">
        {%- if section.settings.kicker != blank -%}<p class="ed-kicker">{% render 'tx', en: section.settings.kicker, ar: section.settings.kicker_ar %}</p>{%- endif -%}
{%- if section.settings.script != blank -%}<p class="ed-script" aria-hidden="true">{% render 'tx', en: section.settings.script, ar: section.settings.script_ar %}</p>{%- endif -%}
        <h2 class="ed-h2">{% render 'ed-em', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
        <p class="ed-body">{% render 'tx', en: section.settings.text, ar: section.settings.text_ar %}</p>
        {%- if section.settings.link != blank -%}
          <a class="ed-btn" href="{{ section.settings.link }}">{% render 'tx', en: section.settings.button, ar: section.settings.button_ar %}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.image_2 != blank -%}
        <figure class="ed-camp__b" data-reveal style="--d: 200ms">
          {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 26vw, 60vw', widths: '400,600,900', alt: section.settings.image_2.alt | default: '' }}
          {%- if section.settings.caption != blank -%}<figcaption class="ed-cap">{% render 'tx', en: section.settings.caption, ar: section.settings.caption_ar %}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}
      {%- if section.settings.products != blank -%}
        <div class="ed-look" data-reveal style="--d: 260ms">
          <p class="ed-look__t">{{ 'general.shop_the_look' | t }}</p>
          <ul class="ed-look__list">
            {%- for p in section.settings.products -%}
              <li>
                <a class="ed-look__p" href="{{ p.url }}">
                  <span class="ed-look__img">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', sizes: '96px' }}{%- endif -%}</span>
                  <span class="ed-look__n">{{ p.title }}</span>
                  <span class="ed-look__pr">{% render 'price', product: p, use_from: true %}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial — campaign",
  "class": "section-ed-campaign",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Handwritten accent",
      "info": "Short, playful line in the brush accent font"
    },
    {
      "type": "text",
      "id": "script_ar",
      "label": "Handwritten accent (Arabic)"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Large image start"
        },
        {
          "value": "right",
          "label": "Large image end"
        }
      ]
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "Off-white"
        },
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "dark",
          "label": "Charcoal"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image",
      "info": "Portrait 4:5"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Detail image",
      "info": "Portrait 3:4"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Detail caption"
    },
    {
      "type": "text",
      "id": "caption_ar",
      "label": "Detail caption (Arabic)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Campaign — Fashion"
    },
    {
      "type": "text",
      "id": "kicker_ar",
      "label": "Kicker (Arabic)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quiet pieces, Seoul attitude."
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading (Arabic)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "text_ar",
      "label": "Text (Arabic)"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "button_ar",
      "label": "Button (Arabic)",
      "default": "اكتشفي"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Shop the look",
      "limit": 3
    }
  ],
  "presets": [
    {
      "name": "Editorial — campaign"
    }
  ]
}
{% endschema %}
