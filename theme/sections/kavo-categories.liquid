<section class="kv-cats section tone-dark">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{% render 'tx', en: section.settings.eyebrow, ar: section.settings.eyebrow_ar %}</p>
        <h2 class="h1">{% render 'tx', en: section.settings.heading, ar: section.settings.heading_ar %}</h2>
      </div>
    </div>
    <div class="kv-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.image
          assign count = 0
          if col != blank
            assign count = col.products_count
            if img == blank
              if col.featured_image
                assign img = col.featured_image
              else
                assign img = col.products.first.featured_media
              endif
            endif
          endif
        -%}
        {%- if count > 0 -%}<a href="{{ col.url }}" class="kv-cat" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 80 }}ms">{%- else -%}<div class="kv-cat is-soon" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 80 }}ms">{%- endif -%}
          <div class="kv-cat__media">
            {%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', widths: '400,600,900', alt: '' }}{%- endif -%}
          </div>
          <div class="kv-cat__info">
            <span class="kv-cat__kr">{{ block.settings.korean }}</span>
            <span class="kv-cat__t">{% render 'tx', en: block.settings.title, ar: block.settings.title_ar %}</span>
            {%- if count > 0 -%}
              <span class="kv-cat__c">{{ 'collections.products_count' | t: count: count }} {% render 'icon', name: 'arrow' %}</span>
            {%- else -%}
              <span class="kv-cat__c kv-cat__c--soon">{{ 'kavo.coming_drop' | t }}</span>
            {%- endif -%}
          </div>
        {%- if count > 0 -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "KAVO categories",
  "class": "section-kavo-cats",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The wardrobe · 옷장" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow (Arabic)", "default": "خزانة KAVO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "heading_ar", "label": "Heading (Arabic)", "default": "تسوقي حسب القطعة" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "korean", "label": "Korean word", "default": "상의" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tops" },
        { "type": "text", "id": "title_ar", "label": "Title (Arabic)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "KAVO categories", "blocks": [{ "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
